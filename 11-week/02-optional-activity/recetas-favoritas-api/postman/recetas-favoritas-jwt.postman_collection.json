{
  "info": {
    "name": "recetas-favoritas-api-jwt",
    "description": "Semana 11 · Flujo de seguridad con JWT: sin token 401, login, con token 200, y autorización por rol (403 / 204).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenUser",
      "value": ""
    },
    {
      "key": "recetaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Sin token: GET lista (debe dar 401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/recetas-favoritas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "recetas-favoritas"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 Unauthorized (sin token)', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "2. Login ADMIN (devuelve el token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('Trae un token', function () { pm.expect(json.token).to.be.a('string').and.not.empty; });",
              "pm.collectionVariables.set('tokenAdmin', json.token);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "3. Login USER (devuelve el token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"user\",\n  \"password\": \"user123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('Trae un token', function () { pm.expect(json.token).to.be.a('string').and.not.empty; });",
              "pm.collectionVariables.set('tokenUser', json.token);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "4. Login con contraseña incorrecta (debe dar 401)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"clave-equivocada\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 Unauthorized (credenciales incorrectas)', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "5. Con token: GET lista (debe dar 200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenUser}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/recetas-favoritas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "recetas-favoritas"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK (con token)', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "6. Con token: POST crear receta (debe dar 201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenUser}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mealId\": \"52772\",\n  \"nombre\": \"Teriyaki Chicken Casserole\",\n  \"categoria\": \"Chicken\",\n  \"area\": \"Japanese\",\n  \"imagenUrl\": \"https://www.themealdb.com/images/media/meals/wrpwuu1511786491.jpg\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/recetas-favoritas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "recetas-favoritas"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created (con token)', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('recetaId', pm.response.json().id);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "7. DELETE con rol USER (debe dar 403)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenUser}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/recetas-favoritas/{{recetaId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "recetas-favoritas",
            "{{recetaId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403 Forbidden (autenticado pero sin permiso)', function () { pm.response.to.have.status(403); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "8. DELETE con rol ADMIN (debe dar 204)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenAdmin}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/recetas-favoritas/{{recetaId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "recetas-favoritas",
            "{{recetaId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('204 No Content (ADMIN puede borrar)', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}